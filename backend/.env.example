ENVIRONMENT=development      # development | test | staging | production (production enforces safe settings)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # backend only; never frontend
DATABASE_URL=                # only if direct DB access is used
CORS_ORIGINS=http://localhost:5173   # exact origins, comma separated; production: https only, never *
MAX_UPLOAD_MB=25
MAX_JSON_KB=512              # largest non-file request body
SIGNED_URL_TTL_SECONDS=120
ASSIGNMENT_MAX_DUE_DAYS=366
ALLOWED_FILE_EXTENSIONS=pdf,docx,pptx,xlsx,csv,png,jpg,jpeg,zip
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
RESET_RATE_LIMIT=5
RESET_RATE_WINDOW_SECONDS=900
PASSWORD_CHANGE_RATE_LIMIT=5
PASSWORD_CHANGE_RATE_WINDOW_SECONDS=900
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW_SECONDS=60
REPORT_RATE_LIMIT=60
REPORT_RATE_WINDOW_SECONDS=60
SLOW_REQUEST_SECONDS=2.0     # slower requests are logged as warnings (target: under 2 s)
HSTS_MAX_AGE_SECONDS=31536000
LOG_LEVEL=INFO
DATABASE_TIMEOUT_SECONDS=15  # a stuck database call fails after this long (503 for the user)
STORAGE_TIMEOUT_SECONDS=60   # file storage calls
